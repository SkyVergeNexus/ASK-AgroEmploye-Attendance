# Cloudflare R2 persistent image storage (set these on the backend host)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Set this to true on production hosts without NODE_ENV=production.
# PERSISTENT_IMAGE_STORAGE_REQUIRED=true

# SMTP settings for notification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_APP_URL=
SMTP_CREDENTIALS_ENCRYPTION_KEY=

# Optional Outlook.com / Hotmail OAuth2 sender
MICROSOFT_OAUTH_CLIENT_ID=
